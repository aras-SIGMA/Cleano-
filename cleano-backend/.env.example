# ---------------------------------------------------------------------------
# server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# database: Aiven Cloud MySQL 8 (SSL wajib)
# salin nilai dari dashboard Aiven > service MySQL > Overview / Quick connect
#   DB_HOST  = mysql-xxxxxxxxx-cleano.aivencloud.com   (tanpa https://)
#   DB_PORT  = 12345                                   (port dinamis Aiven)
#   DB_USER  = avnadmin
#   DB_NAME  = defaultdb                               (atau cleano_db)
#   DB_SSL_CA= ./certs/ca.pem                          (unduh dari Aiven > CA certificate)
# timezone pool dipaksa +07:00 supaya paid_at / curdate() konsisten WIB
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=cleano_db
DB_SSL=true
DB_SSL_CA=./certs/ca.pem
# true = menolak jalan bila ca.pem tidak ada. Wajib di produksi; biarkan kosong
# saat pengembangan supaya koneksi tetap jalan tanpa verifikasi sertifikat.
# [aman] sekarang ca.pem sudah terisi dan diverifikasi di database.js
DB_SSL_VERIFY=true
DB_TIMEZONE=+07:00
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------------
# auth
# ---------------------------------------------------------------------------
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=24h

# Batas percobaan per IP. Kosongkan untuk memakai bawaan (login 10/15 menit,
# register 5/jam). Skrip uji menaikkannya sendiri.
AUTH_LOGIN_LIMIT=
AUTH_REGISTER_LIMIT=

# ---------------------------------------------------------------------------
# midtrans snap (sandbox)
# ---------------------------------------------------------------------------
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ---------------------------------------------------------------------------
# upload
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_IMAGE_MB=2

# Batas ukuran body JSON. Upload foto memakai jalur multipart sendiri (MAX_IMAGE_MB).
JSON_BODY_LIMIT=1mb

# Origin yang boleh memanggil API, dipisah koma. Kosong = semua origin
# (aplikasi mobile tidak mengirim Origin).
CORS_ORIGINS=

# Jumlah hop reverse proxy yang boleh dipercaya (Railway/Render/nginx = 1).
# 0 = tanpa proxy. Jangan diisi 'true': itu mempercayai X-Forwarded-For apa
# adanya, sehingga klien bisa memalsukan IP dan melewati rate limit.
TRUST_PROXY_HOPS=0