# Salin file ini menjadi .env lalu isi nilainya.
# .env TIDAK di-commit (sudah masuk .gitignore).

# URL backend Cleano (cleano-backend).
# Android emulator   : http://10.0.2.2:3000
# iOS simulator      : http://localhost:3000
# Perangkat fisik    : http://<IP-LAN-komputer>:3000
# Produksi           : https://<domain-backend>
API_BASE_URL=http://10.0.2.2:3000

# Client Key Midtrans Snap (AMAN di frontend, berbeda dari server key).
# Ambil dari Midtrans Sandbox > Settings > Access Keys.
MIDTRANS_CLIENT_KEY=